# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (get from https://dash.voyageai.com)
VOYAGE_API_KEY=pa-...

# Pinecone (get from https://app.pinecone.io)
PINECONE_API_KEY=...
